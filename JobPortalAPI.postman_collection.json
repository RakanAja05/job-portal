{
  "info": {
    "_postman_id": "b6e6e9d0-1111-4a77-9abc-jobportal-api-collection",
    "name": "Job Portal API Praktikum 6",
    "description": "Collection untuk menguji REST API Job Portal (Sanctum + Swagger). Termasuk filter, pagination, public endpoint, apply lamaran, dan update status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"User Demo\",\n  \"email\": \"userdemo@mail.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/register",
          "host": ["{{base_url}}"],
          "path": ["api", "register"]
        }
      },
      "response": []
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"userdemo@mail.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": ["{{base_url}}"],
          "path": ["api", "login"]
        },
        "description": "Salin field token dari response lalu set ke variable {{token}} di environment. Screenshot: ss-swagger-token.png"
      }
    },
    {
      "name": "Auth - Me (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "url": {
          "raw": "{{base_url}}/api/me",
          "host": ["{{base_url}}"],
          "path": ["api", "me"]
        }
      }
    },
    {
      "name": "Jobs - List (Filter & Pagination)",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "url": {
          "raw": "{{base_url}}/api/jobs?keyword=Dev&company=ACME&location=Jakarta&page=1&per_page=5",
          "host": ["{{base_url}}"],
          "path": ["api", "jobs"],
          "query": [
            {"key": "keyword", "value": "Dev"},
            {"key": "company", "value": "ACME"},
            {"key": "location", "value": "Jakarta"},
            {"key": "page", "value": "1"},
            {"key": "per_page", "value": "5"}
          ]
        },
        "description": "Screenshot filter: ss-postman-filter.png; Screenshot pagination: ss-postman-pagination.png"
      }
    },
    {
      "name": "Jobs - Public List (Tanpa Token)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/public/jobs?keyword=Dev",
          "host": ["{{base_url}}"],
          "path": ["api", "public", "jobs"],
          "query": [
            {"key": "keyword", "value": "Dev"}
          ]
        },
        "description": "Screenshot public endpoint: ss-postman-public.png"
      }
    },
    {
      "name": "Jobs - Create (Admin Only)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{admin_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Frontend Dev\",\n  \"description\": \"Vue/React\",\n  \"location\": \"Jakarta\",\n  \"company\": \"ACME\",\n  \"salary\": 12000000,\n  \"type\": \"full-time\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/jobs",
          "host": ["{{base_url}}"],
          "path": ["api", "jobs"]
        }
      }
    },
    {
      "name": "Jobs - Show",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "url": {
          "raw": "{{base_url}}/api/jobs/{{job_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "jobs", "{{job_id}}"]
        }
      }
    },
    {
      "name": "Applications - Apply (Upload CV)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "cv", "type": "file", "src": "./sample-cv.pdf", "description": "Pilih file PDF <=2MB"}
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/jobs/{{job_id}}/apply",
          "host": ["{{base_url}}"],
          "path": ["api", "jobs", "{{job_id}}", "apply"]
        }
      }
    },
    {
      "name": "Applications - List (Admin Only)",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{admin_token}}"}
        ],
        "url": {
          "raw": "{{base_url}}/api/applications?page=1&per_page=10",
          "host": ["{{base_url}}"],
          "path": ["api", "applications"],
          "query": [
            {"key": "page", "value": "1"},
            {"key": "per_page", "value": "10"}
          ]
        }
      }
    },
    {
      "name": "Applications - Update Status (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {"key": "Authorization", "value": "Bearer {{admin_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Accepted\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/applications/{{application_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["api", "applications", "{{application_id}}", "status"]
        },
        "description": "Screenshot PATCH status: ss-postman-admin-patch.png"
      }
    },
    {
      "name": "Auth - Logout",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "url": {
          "raw": "{{base_url}}/api/logout",
          "host": ["{{base_url}}"],
          "path": ["api", "logout"]
        }
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {"exec": ["// Prerequest placeholder"], "type": "text/javascript"}
    },
    {
      "listen": "test",
      "script": {"exec": ["pm.test('Status code is 2xx', function () { pm.expect(pm.response.code).to.be.within(200,299); });"], "type": "text/javascript"}
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://127.0.0.1:8000"},
    {"key": "token", "value": ""},
    {"key": "admin_token", "value": ""},
    {"key": "job_id", "value": "1"},
    {"key": "application_id", "value": "1"}
  ]
}
