            "get": {
                "tags": [
                    "Applications"
                ],
                "summary": "List applications",
                "operationId": "895749895f8d7900e2b7a93830d1f67f",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "required": false
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated applications"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/jobs/{id}/apply": {
            "post": {
                "tags": [
                    "Applications"
                ],
                "summary": "Apply to job",
                "operationId": "e96804e85fcd63351097a684e1968321",
                "responses": {
                    "201": {
                        "description": "Application submitted"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/applications/{id}/status": {
